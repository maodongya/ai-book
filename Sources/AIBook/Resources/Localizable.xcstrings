    "operation.mic.help": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住说话，松开后执行。也可按住 Option+空格"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold to speak, release to run. Or hold Option-Space"
