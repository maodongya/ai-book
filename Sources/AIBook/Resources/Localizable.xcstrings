    "translation.target.hint": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅影响之后发起的翻译，不会更改当前译文"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to future translations without changing the current translation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後の翻訳にのみ適用され、現在の訳文は変更されません"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt nur für neue Übersetzungen; die aktuelle bleibt unverändert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique aux prochaines traductions sans modifier la traduction actuelle"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale per le traduzioni future senza modificare quella corrente"
          }
        },
        "la": {
          "stringUnit": {
            "state": "translated",
            "value": "Translationibus futuris tantum valet; praesentem non mutat"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ισχύει μόνο για νέες μεταφράσεις χωρίς αλλαγή της τρέχουσας"
          }
        }
      }
    },
