    "qwen.hint.beijing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在百炼控制台「华北2（北京）」创建 API Key，与下方 Base URL 地域一致。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create the API key in the Beijing console. It must match the Base URL region."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "百煉コンソールの「華北2（北京）」で API Key を作成し、下の Base URL の地域と一致させてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie den API-Key in der Konsole „Nordchina 2 (Peking)“. Er muss zur Region der Base URL passen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez la clé API dans la console « Chine du Nord 2 (Pékin) ». Elle doit correspondre à la région de l’URL de base."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea la chiave API nella console « Cina settentrionale 2 (Pechino) ». Deve corrispondere alla regione dell’URL di base."
          }
        },
        "la": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea clavem API in console « Sina septentrionalis 2 (Pechinum) ». Congruat cum regione Base URL."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργήστε το κλειδί API στην κονσόλα « Βόρεια Κίνα 2 (Πεκίνο) ». Πρέπει να ταιριάζει με την περιοχή του Base URL."
          }
        }
      }
    },
    "qwen.hint.singapore": {
      "localizations": {
        "zh-Hans": {
