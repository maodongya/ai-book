          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qwen d’Alibaba Cloud (compatible OpenAI). Région par défaut Pékin %@. Créez la clé sur la page API de la console."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qwen di Alibaba Cloud (compatibile OpenAI). Regione predefinita Pechino %@. Crea la chiave nella pagina API della console."
          }
        },
        "la": {
          "stringUnit": {
            "state": "translated",
            "value": "Qwen Alibaba Cloud (compatibile OpenAI). Regio default Pechinum %@. Crea clavem in pagina API consolae."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Qwen της Alibaba Cloud (συμβατό με OpenAI). Προεπιλεγμένη περιοχή Πεκίνο %@. Δημιουργήστε το κλειδί στη σελίδα API της κονσόλας."
          }
        }
      }
    },
