    "welcome.evolution": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是 AI 进化选项卡，自我进化流程：\n· ① 分析优化：Cursor 只读探索源码，将改进点写入优化队列\n· ② 进化改码：取下一条待办，Agent 改码并自动构建重启\n· 左页编号命令（N、…）与优化队列双向同步；完成项自动标记「已完成」\n· 顶栏「进化操作」菜单：保存/打开进化命令到本地 .txt\n· 顶栏：Cursor 模型、自动升级与优化队列\n· 输入框可写分析方向；底栏「分析优化」只读探索并入队（不改码）\n· 「进化」或 ⌘E：取下一条待办并改码、构建重启；「发送」用于进化追问\n· 执行时流式展示 Agent 执行过程与最终回复\n· 「自动升级」开启后改码完成将打包重启并继续下一条\n· 输入栏下方显示 Token 已用/剩余；超限将阻止进化与追问\nCursor Key 与桥接请在顶栏「进化设置」中配置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Evolution tab — analyze source, enqueue improvements, run Cursor Agent to modify code, build and restart. Configure Cursor in Evolution settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Evolution tab — analyze source, enqueue improvements, run Cursor Agent to modify code, build and restart. Configure Cursor in Evolution settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Evolution tab — analyze source, enqueue improvements, run Cursor Agent to modify code, build and restart. Configure Cursor in Evolution settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Evolution tab — analyze source, enqueue improvements, run Cursor Agent to modify code, build and restart. Configure Cursor in Evolution settings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Evolution tab — analyze source, enqueue improvements, run Cursor Agent to modify code, build and restart. Configure Cursor in Evolution settings."
          }
        },
        "la": {
          "stringUnit": {
