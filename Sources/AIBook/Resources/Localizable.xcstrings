    "llm.hint.ollama": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机 Ollama，离线可用；设置页可自动扫描已安装模型并选择。支持 OLLAMA_HOST 环境变量与可选 API Key。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local Ollama, works offline. Settings can scan installed models. Supports OLLAMA_HOST and an optional API key."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルの Ollama。オフラインで使えます。設定でインストール済みモデルを走査して選べます。OLLAMA_HOST と任意の API Key に対応します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokales Ollama, auch offline. Die Einstellungen können installierte Modelle suchen. OLLAMA_HOST und ein optionaler API-Key werden unterstützt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama local, utilisable hors ligne. Les réglages peuvent chercher les modèles installés. OLLAMA_HOST et une clé API facultative sont pris en charge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama locale, anche offline. Le impostazioni possono cercare i modelli installati. Sono supportati OLLAMA_HOST e una chiave API facoltativa."
          }
        },
        "la": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama locale, etiam sine rete. Configuratio modela installata quaerere potest. OLLAMA_HOST et clavis API optativa sustinentur."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τοπικό Ollama, και χωρίς δίκτυο. Οι ρυθμίσεις μπορούν να βρουν εγκατεστημένα μοντέλα. Υποστηρίζονται OLLAMA_HOST και προαιρετικό κλειδί API."
          }
        }
      }
    },
    "llm.hint.custom": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任意 OpenAI 兼容接口，自行填写地址与模型。"
          }
        },
        "en": {
