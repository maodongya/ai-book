        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "阿里雲百煉の通義千問（OpenAI 互換）。既定は北京地域 %@。Key は百煉コンソールの API ページで作成します。"
          }
        },
        "de": {
          "stringUnit": {
